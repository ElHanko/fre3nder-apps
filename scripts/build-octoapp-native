#!/usr/bin/env python3
from pathlib import Path
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parents[1]
VERSION = "3.21.0"
SOURCE_SHA256 = "222d0bd05381dd25c32dd6065c071ebf084212ab79bab4599ba9e6a3e0009e6c"


def fail(msg):
    raise SystemExit(f"build-octoapp-native: {msg}")


def tree_hash(root):
    h = hashlib.sha256()

    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        h.update(path.relative_to(root).as_posix().encode("utf-8"))
        h.update(b"\0")
        h.update(hashlib.sha256(path.read_bytes()).digest())

    return h.hexdigest()


def copy_checked(src, dst):
    if not src.is_dir():
        fail(f"missing directory: {src}")

    for path in src.rglob("*"):
        if path.is_symlink():
            fail(f"symlink rejected: {path}")

    shutil.copytree(src, dst)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--buildroot-output",
        required=True,
        type=Path,
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=ROOT / "local/octoapp/pycryptodomex",
    )
    args = parser.parse_args()

    br = args.buildroot_output.resolve()
    target = br / "target"
    readelf = br / "host/bin/mipsel-buildroot-linux-gnu-readelf"

    target_namespace = (
        target
        / "usr/lib/python3.12/site-packages/Cryptodome"
    )

    if not (br / "Makefile").is_file():
        fail(f"Buildroot output missing Makefile: {br}")

    if not readelf.is_file():
        fail(f"cross readelf missing: {readelf}")

    if target_namespace.exists():
        fail(
            "Cryptodome already exists in target RootFS; "
            "expected app-local dependency"
        )

    project = next(
        (
            parent
            for parent in br.parents
            if (parent / "VERSION").is_file()
            and (parent / "build/x2000/Dockerfile").is_file()
        ),
        None,
    )
    if project is None:
        fail("Fre3nder project root not found")

    work = br.parent
    version = (project / "VERSION").read_text().strip()
    image = f"ender3-v3-ke-fre3nder-x2000:{version}"
    docker = os.environ.get("X2000_BUILD_DOCKER", "docker")
    runtime_user = f"{os.getuid()}:{os.getgid()}"

    if subprocess.run(
        [docker, "image", "inspect", image],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ).returncode != 0:
        fail(f"Fre3nder X2000 build image missing: {image}")

    def run_buildroot_target(target, offline=False):
        command = [
            docker,
            "run",
            "--rm",
            "--user",
            runtime_user,
        ]
        if offline:
            command += ["--network", "none"]

        command += [
            "-v",
            f"{project}:/project:ro",
            "-v",
            f"{work}:/work",
            "--entrypoint",
            "/usr/bin/make",
            image,
            "-C",
            "/work/buildroot-output-fre3nder",
            target,
        ]

        subprocess.run(command, check=True)

    run_buildroot_target("python-pycryptodomex-source")
    run_buildroot_target("python-pycryptodomex-build", offline=True)

    if target_namespace.exists():
        fail(
            "build-only target unexpectedly modified "
            "target RootFS"
        )

    pkg = br / f"build/python-pycryptodomex-{VERSION}"
    build_dir = pkg / "build"

    if not build_dir.is_dir():
        fail(f"package build directory missing: {build_dir}")

    candidates = [
        path
        for path in build_dir.glob("lib*/Cryptodome")
        if path.is_dir() and any(path.rglob("*.so"))
    ]

    if len(candidates) != 1:
        fail(
            "expected one built Cryptodome tree, "
            f"found {len(candidates)}"
        )

    crypto = candidates[0]

    extensions = sorted(
        crypto.rglob("*.so")
    )

    if not extensions:
        fail("no native Cryptodome extensions found")

    needed = set()

    for so in extensions:
        header = subprocess.run(
            [
                str(readelf),
                "-h",
                str(so),
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout

        attrs = subprocess.run(
            [
                str(readelf),
                "-A",
                str(so),
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout

        for needle, haystack in (
            ("ELF32", header),
            ("little endian", header),
            ("o32", header),
            ("mips32r2", header),
            ("nan2008", header),
            ("ISA: MIPS32r2", attrs),
            (
                "FP ABI: Hard float "
                "(32-bit CPU, Any FPU)",
                attrs,
            ),
        ):
            if needle not in haystack:
                fail(
                    f"{so}: ABI check failed: "
                    f"{needle}"
                )

        dynamic = subprocess.run(
            [
                str(readelf),
                "-d",
                str(so),
            ],
            check=True,
            text=True,
            stdout=subprocess.PIPE,
        ).stdout

        for line in dynamic.splitlines():
            marker = "Shared library: ["

            if marker in line:
                needed.add(
                    line
                    .split(marker, 1)[1]
                    .split("]", 1)[0]
                )

    unresolved = []

    for soname in sorted(needed):
        found = any(
            base.exists()
            and any(base.rglob(soname))
            for base in (
                target / "lib",
                target / "usr/lib",
            )
        )

        if not found:
            unresolved.append(soname)

    if unresolved:
        fail(
            "unresolved target libraries: "
            + ", ".join(unresolved)
        )

    license_file = pkg / "LICENSE.rst"

    copyright_file = (
        pkg
        / "Doc/LEGAL/COPYRIGHT.pycrypto"
    )

    if (
        not license_file.is_file()
        or not copyright_file.is_file()
    ):
        fail(
            "pycryptodomex license material missing"
        )

    out = args.output.resolve()

    out.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with tempfile.TemporaryDirectory(
        prefix=".octoapp-native-",
        dir=out.parent,
    ) as td:
        stage = Path(td)

        site = (
            stage
            / "site-packages"
        )

        site.mkdir(
            parents=True
        )

        copy_checked(
            crypto,
            site / "Cryptodome",
        )

        dist = (
            site
            / f"pycryptodomex-{VERSION}.dist-info"
        )

        licenses = (
            dist
            / "licenses"
        )

        licenses.mkdir(
            parents=True
        )

        shutil.copy2(
            license_file,
            licenses / "LICENSE.rst",
        )

        shutil.copy2(
            copyright_file,
            licenses / "COPYRIGHT.pycrypto",
        )

        (
            dist / "METADATA"
        ).write_text(
            "Metadata-Version: 2.1\n"
            "Name: pycryptodomex\n"
            f"Version: {VERSION}\n"
            "License: BSD-2-Clause, Public Domain\n",
            encoding="utf-8",
        )

        (
            stage / "native.json"
        ).write_text(
            json.dumps(
                {
                    "schema": 1,
                    "name": "pycryptodomex",
                    "version": VERSION,
                    "namespace": "Cryptodome",
                    "source_sha256": SOURCE_SHA256,
                    "buildroot_target":
                        "python-pycryptodomex-build",
                    "extension_count":
                        len(extensions),
                    "needed":
                        sorted(needed),
                    "tree_sha256":
                        tree_hash(site),
                },
                indent=2,
                sort_keys=True,
            )
            + "\n",
            encoding="utf-8",
        )

        if out.exists():
            shutil.rmtree(out)

        shutil.copytree(
            stage,
            out,
        )

    print(out)
    print(
        f"extensions={len(extensions)}"
    )
    print(
        "needed="
        + ",".join(sorted(needed))
    )
    print("NATIVE=PASS")


if __name__ == "__main__":
    main()
