#!/bin/sh

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1

cd "$ROOT" || exit 1

FRE3NDER_ROOT=${FRE3NDER_ROOT:-../fre3nder}
BUILDROOT_OUTPUT="$FRE3NDER_ROOT/local/production/work/x2000/buildroot-output-fre3nder"
KEY="$FRE3NDER_ROOT/local/production/keys/apps/private.pem"

REFRESH_NATIVE=0
REFRESH_LOCK=0
OUTPUT=""

usage() {
    cat <<EOF
Usage: scripts/build-octoapp [options]

Build the pinned OctoApp .fre3app package.

Options:
  --refresh-native
      Rebuild the app-local pycryptodomex dependency first.

  --refresh-lock
      Re-resolve the pure-Python dependency lock first.

  --buildroot-output PATH
      Override the Fre3nder X2000 Buildroot output.

  --key PATH
      Override the Ed25519 signing private key.

  --output PATH
      Override the output .fre3app path.

  -h, --help
      Show this help.

Defaults:
  Fre3nder root:
    $FRE3NDER_ROOT

  Buildroot output:
    $BUILDROOT_OUTPUT

  Signing key:
    $KEY
EOF
}

fail() {
    printf 'build-octoapp: %s\n' "$*" >&2
    exit 1
}

run() {
    printf '\n=== %s ===\n' "$1"
    shift
    "$@"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        printf 'build-octoapp: step failed with exit %s\n' "$rc" >&2
        exit "$rc"
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --refresh-native)
            REFRESH_NATIVE=1
            shift
            ;;
        --refresh-lock)
            REFRESH_LOCK=1
            shift
            ;;
        --buildroot-output)
            [ "$#" -ge 2 ] || fail "--buildroot-output requires a path"
            BUILDROOT_OUTPUT=$2
            shift 2
            ;;
        --key)
            [ "$#" -ge 2 ] || fail "--key requires a path"
            KEY=$2
            shift 2
            ;;
        --output)
            [ "$#" -ge 2 ] || fail "--output requires a path"
            OUTPUT=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown option: $1"
            ;;
    esac
done

[ -d "$BUILDROOT_OUTPUT" ] \
    || fail "Buildroot output not found: $BUILDROOT_OUTPUT"

[ -f "$KEY" ] \
    || fail "signing key not found: $KEY"

printf '=== OCTOAPP BUILD ===\n'
printf 'buildroot output: %s\n' "$BUILDROOT_OUTPUT"
printf 'refresh native:   %s\n' "$REFRESH_NATIVE"
printf 'refresh lock:     %s\n' "$REFRESH_LOCK"

if [ "$REFRESH_LOCK" -eq 1 ]; then
    run "REFRESH DEPENDENCY LOCK" \
        "$ROOT/scripts/lock-octoapp"
fi

if [ "$REFRESH_NATIVE" -eq 1 ]; then
    run "BUILD NATIVE DEPENDENCIES" \
        "$ROOT/scripts/build-octoapp-native" \
        --buildroot-output "$BUILDROOT_OUTPUT"
fi

run "PREPARE PAYLOAD" \
    "$ROOT/scripts/prepare-octoapp" \
    --buildroot-output "$BUILDROOT_OUTPUT"

run "TESTS" \
    python3 -m unittest tests/test_octoapp_recipe.py -v

run "DIFF CHECK" \
    git diff --check -- \
        apps/octoapp \
        scripts/build-octoapp \
        scripts/build-octoapp-native \
        scripts/lock-octoapp \
        scripts/prepare-octoapp \
        tests/test_octoapp_recipe.py

if [ -n "$OUTPUT" ]; then
    run "BUILD SIGNED PACKAGE" \
        "$ROOT/scripts/build-fre3app" \
        apps/octoapp \
        --key "$KEY" \
        --output "$OUTPUT"
else
    run "BUILD SIGNED PACKAGE" \
        "$ROOT/scripts/build-fre3app" \
        apps/octoapp \
        --key "$KEY"
fi

printf '\n=== OCTOAPP BUILD COMPLETE ===\n'
