#!/usr/bin/env python3
"""Resolve OctoApp's pure-Python runtime wheels into a reviewed lock manifest."""

from __future__ import annotations

import argparse
from email.parser import Parser
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import zipfile


ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "apps/octoapp"
REQUIREMENTS = SOURCE / "requirements.in"
DEFAULT_OUTPUT = SOURCE / "python-wheels.json"
PYTHON_TARGET = "3.12"
PIP_VERSION = "26.2.1"
PIP_WHEEL = f"pip-{PIP_VERSION}-py3-none-any.whl"
PIP_URL = (
    "https://files.pythonhosted.org/packages/f3/6e/"
    "1736e5b4ae2b778ef2f81c47d797de9f891d4d8acb047a24ca37a60294dd/"
    + PIP_WHEEL
)
PIP_SHA256 = "71138adf1f4ca900cdb7d289c21b7494329f2332b6d85f0e1c42108c0384ed3e"
PIP_SIZE = 1816632


def fail(message: str) -> "None":
    raise ValueError(message)


def bootstrap_pip(destination: Path) -> Path:
    wheel = destination / PIP_WHEEL
    request = urllib.request.Request(
        PIP_URL,
        headers={"User-Agent": "fre3nder-apps/lock-octoapp"},
    )
    digest = hashlib.sha256()
    size = 0
    with urllib.request.urlopen(request, timeout=60) as response, wheel.open("xb") as output:
        if not response.geturl().startswith("https://"):
            fail("pinned pip bootstrap download left HTTPS")
        for chunk in iter(lambda: response.read(1024 * 1024), b""):
            size += len(chunk)
            if size > PIP_SIZE:
                fail("pinned pip bootstrap exceeds expected size")
            digest.update(chunk)
            output.write(chunk)
    if size != PIP_SIZE:
        fail(f"pinned pip bootstrap size mismatch: {size} != {PIP_SIZE}")
    if digest.hexdigest() != PIP_SHA256:
        fail("pinned pip bootstrap SHA-256 mismatch")
    return wheel


def wheel_metadata(path: Path) -> dict:
    with zipfile.ZipFile(path) as archive:
        metadata_names = [
            name for name in archive.namelist()
            if name.endswith(".dist-info/METADATA")
        ]
        if len(metadata_names) != 1:
            fail(f"wheel has unexpected METADATA layout: {path.name}")
        message = Parser().parsestr(
            archive.read(metadata_names[0]).decode("utf-8", "replace")
        )
    name = message.get("Name")
    version = message.get("Version")
    if not name or not version:
        fail(f"wheel lacks Name or Version metadata: {path.name}")
    license_value = message.get("License-Expression") or message.get("License") or ""
    return {
        "name": name,
        "version": version,
        "filename": path.name,
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
        "license": license_value.strip(),
        "source_url": f"https://pypi.org/project/{name}/{version}/",
    }


def resolve(output: Path) -> None:
    if not REQUIREMENTS.is_file():
        fail(f"requirements file is missing: {REQUIREMENTS}")

    with tempfile.TemporaryDirectory(prefix="fre3nder-octoapp-lock-") as tmp:
        wheel_dir = Path(tmp) / "wheels"
        wheel_dir.mkdir()
        pip_wheel = bootstrap_pip(Path(tmp))
        command = [
            sys.executable,
            "-m",
            "pip",
            "--isolated",
            "download",
            "--disable-pip-version-check",
            "--no-cache-dir",
            "--only-binary=:all:",
            "--platform", "any",
            "--python-version", PYTHON_TARGET,
            "--implementation", "py",
            "--abi", "none",
            "--dest", str(wheel_dir),
            "--requirement", str(REQUIREMENTS),
        ]
        env = dict(os.environ)
        existing = env.get("PYTHONPATH")
        env["PYTHONPATH"] = (
            str(pip_wheel)
            if not existing
            else str(pip_wheel) + os.pathsep + existing
        )
        result = subprocess.run(command, check=False, env=env)
        if result.returncode != 0:
            fail(f"pip download failed with exit {result.returncode}")

        wheels = sorted(wheel_dir.glob("*.whl"))
        unexpected = sorted(
            path.name for path in wheel_dir.iterdir() if path.suffix != ".whl"
        )
        if not wheels or unexpected:
            fail(f"resolver produced unexpected files: {unexpected}")

        entries = [wheel_metadata(path) for path in wheels]
        names = [entry["name"].lower().replace("_", "-") for entry in entries]
        if len(names) != len(set(names)):
            fail("resolver produced duplicate normalized project names")

    document = {
        "schema": 1,
        "purpose": "Pinned pure-Python runtime wheels for OctoApp on Fre3nder",
        "resolver": {
            "name": "pip",
            "version": PIP_VERSION,
            "wheel_sha256": PIP_SHA256,
        },
        "target": {
            "python": PYTHON_TARGET,
            "platform": "any",
            "implementation": "py",
            "abi": "none",
        },
        "requirements": [
            line.strip()
            for line in REQUIREMENTS.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ],
        "wheels": entries,
    }
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(
        json.dumps(document, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(output)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    try:
        resolve(args.output)
    except (OSError, ValueError, zipfile.BadZipFile) as exc:
        print(f"lock-octoapp: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
