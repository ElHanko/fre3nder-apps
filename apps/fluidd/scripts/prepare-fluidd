#!/usr/bin/env python3
"""Prepare the pinned Fluidd release as signed-package source on the host."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
import urllib.request
import zipfile


ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "scripts"))
from stage_fre3app import checked_file, input_digest, package_stage

SOURCE = ROOT / "apps/fluidd"
CACHE_DIR = ROOT / "local/fluidd"
DEFAULT_OUTPUT = ROOT / "local/fluidd/package"
PACKAGE_FILES = ("upstream.json", "licenses/UPSTREAM", "licenses/LICENSE.fluidd")
MAX_UNPACKED = 1024 * 1024 * 1024


def report(message):
    print(f"prepare-fluidd: {message}", file=sys.stderr, flush=True)


def format_size(size):
    if size < 1024:
        return f"{size} B"
    if size < 1024 * 1024:
        return f"{size / 1024:.1f} KiB"
    return f"{size / (1024 * 1024):.1f} MiB"


def validate_upstream(upstream):
    if (not isinstance(upstream, dict) or upstream.get("project") != "fluidd-core/fluidd"
            or not isinstance(upstream.get("version"), str)
            or not re.fullmatch(r"v[0-9][A-Za-z0-9.+_-]{0,126}", upstream["version"])
            or not isinstance(upstream.get("source_commit"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", upstream["source_commit"])
            or upstream.get("license") != "GPL-3.0-only"
            or type(upstream.get("asset_size")) is not int or upstream["asset_size"] <= 0
            or not isinstance(upstream.get("asset_sha256"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", upstream["asset_sha256"])):
        raise ValueError("invalid Fluidd release definition")
    expected = f"https://github.com/fluidd-core/fluidd/releases/download/{upstream['version']}/fluidd.zip"
    if upstream.get("asset_url") != expected:
        raise ValueError("Fluidd archive URL does not match the selected upstream release")
    if upstream.get("license_source") != f"https://github.com/fluidd-core/fluidd/blob/{upstream['source_commit']}/LICENSE":
        raise ValueError("Fluidd license source does not match the selected source commit")


def verify_archive(path, upstream):
    if path.is_symlink() or not path.is_file():
        raise ValueError("Fluidd archive must be a regular file")
    if path.stat().st_size != upstream["asset_size"]:
        raise ValueError("Fluidd archive size mismatch")
    digest = hashlib.sha256()
    with path.open("rb") as archive:
        for chunk in iter(lambda: archive.read(1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest() != upstream["asset_sha256"]:
        raise ValueError("Fluidd archive SHA-256 mismatch")


def download(path, upstream):
    request = urllib.request.Request(upstream["asset_url"])
    size = 0
    next_report = 1024 * 1024
    expected_size = upstream["asset_size"]
    with urllib.request.urlopen(request, timeout=60) as response, path.open("xb") as output:
        if not response.geturl().startswith("https://"):
            raise ValueError("Fluidd download left HTTPS")
        for chunk in iter(lambda: response.read(1024 * 1024), b""):
            size += len(chunk)
            if size > upstream["asset_size"]:
                raise ValueError("Fluidd download exceeds pinned size")
            output.write(chunk)
            if size >= next_report:
                report(f"downloaded {format_size(size)} / {format_size(expected_size)}")
                next_report += 1024 * 1024
    if size != upstream["asset_size"]:
        raise ValueError("Fluidd download size mismatch")


def cached_archive(upstream, cache_dir=None):
    cache_dir = CACHE_DIR if cache_dir is None else cache_dir
    if cache_dir.is_symlink() or (cache_dir.exists() and not cache_dir.is_dir()):
        raise ValueError("Fluidd cache must be a real directory")
    cache_dir.mkdir(parents=True, exist_ok=True)
    # Hash in the name keeps old pins distinct when the upstream version changes.
    filename = f"fluidd-{upstream['version']}-{upstream['asset_sha256'][:12]}.zip"
    archive = cache_dir / filename
    if archive.exists() or archive.is_symlink():
        verify_archive(archive, upstream)
        report(f"cached archive: {archive.name}, SHA-256 OK")
        return archive
    report(f"downloading Fluidd {upstream['version']} ({format_size(upstream['asset_size'])})")
    with tempfile.TemporaryDirectory(dir=cache_dir, prefix=".fluidd-download-") as tmp:
        temporary = Path(tmp) / "fluidd.zip"
        download(temporary, upstream)
        verify_archive(temporary, upstream)
        temporary.rename(archive)
    report("download complete, SHA-256 OK")
    return archive


def extract(archive_path, destination):
    seen = set()
    total = 0
    with zipfile.ZipFile(archive_path) as archive:
        for member in archive.infolist():
            name = member.filename
            logical = name[:-1] if member.is_dir() else name
            parts = logical.split("/")
            mode = stat.S_IFMT(member.external_attr >> 16)
            if (not logical or name.startswith("/") or "\\" in name
                    or any(ord(char) < 32 or ord(char) == 127 for char in name)
                    or any(part in ("", ".", "..") for part in parts)
                    or logical in seen
                    or mode not in (0, stat.S_IFREG, stat.S_IFDIR)):
                raise ValueError(f"unsafe Fluidd ZIP member: {name!r}")
            seen.add(logical)
            total += member.file_size
            if total > MAX_UNPACKED:
                raise ValueError("Fluidd ZIP exceeds unpacked size limit")
            target = destination.joinpath(*parts)
            if member.is_dir():
                target.mkdir(parents=True, exist_ok=True)
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                with archive.open(member) as source, target.open("xb") as output:
                    shutil.copyfileobj(source, output)


def validate_payload(payload, upstream):
    index = payload / "index.html"
    info = payload / "release_info.json"
    if not index.is_file() or not index.stat().st_size or not info.is_file():
        raise ValueError("Fluidd payload lacks index.html or release_info.json")
    data = json.loads(info.read_text())
    if (not isinstance(data, dict) or data.get("project_name") != "fluidd"
            or data.get("project_owner") != "fluidd-core"
            or data.get("version") != upstream["version"]):
        raise ValueError("Fluidd release_info.json identity or version mismatch")


def prepare(archive_path, destination, upstream):
    report("verifying pinned Fluidd archive")
    verify_archive(archive_path, upstream)
    if destination.is_symlink():
        raise ValueError("Fluidd payload destination must not be a symlink")
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=destination.parent, prefix=".fluidd-") as tmp:
        temporary = Path(tmp)
        staged = temporary / "payload"
        staged.mkdir()
        report("extracting Fluidd payload")
        extract(archive_path, staged)
        report("checking Fluidd release identity")
        validate_payload(staged, upstream)
        previous = temporary / "previous"
        if destination.exists():
            report("replacing existing payload")
            os.replace(destination, previous)
        try:
            os.replace(staged, destination)
        except OSError:
            if previous.exists():
                os.replace(previous, destination)
            raise


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--archive", type=Path, help="use an already downloaded archive")
    parser.add_argument("--upstream", type=Path, help="external release definition")
    parser.add_argument("--output", type=Path, help="prepared package source directory")
    args = parser.parse_args()
    default = checked_file(SOURCE / "upstream.json")
    selected = checked_file(args.upstream) if args.upstream is not None else default
    inputs = {"upstream.json": selected}
    upstream = json.loads(selected)
    validate_upstream(upstream)
    changed = selected != default
    identity = input_digest(inputs)
    output = args.output or (CACHE_DIR / "inputs" / identity / "package" if changed else DEFAULT_OUTPUT)
    cache = CACHE_DIR / "inputs" / identity if changed else CACHE_DIR
    archive = args.archive if args.archive is not None else (
        cache / f"fluidd-{upstream['version']}-{upstream['asset_sha256'][:12]}.zip")
    if changed:
        inputs["licenses/UPSTREAM"] = (
            b"Maintained recipe baseline notices; selected build provenance is in upstream.json.\n\n"
            + checked_file(SOURCE / "licenses/UPSTREAM"))
    with package_stage(SOURCE, output, files=PACKAGE_FILES, overrides=inputs,
                       protected=(args.upstream, archive)) as stage:
        if args.archive is None:
            archive = cached_archive(upstream, cache)
        prepare(archive, stage / "payload", upstream)
    report(f"ready: {output}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, zipfile.BadZipFile, json.JSONDecodeError) as exc:
        print(f"prepare-fluidd: {exc}", file=sys.stderr)
        sys.exit(1)
