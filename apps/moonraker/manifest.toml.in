format = 1

[app]
name = "moonraker"
version = "0.0.0-fre3nder.0.bootstrap"
release_serial = 0

[publisher]
id = "fre3nder-official"
key_fingerprint = "@PUBLISHER_FINGERPRINT@"

[target]
platform = "fre3nder-x2000"
arch = "mipsel"

[runtime]
service = "service"
autostart = false

[signature]
algorithm = "Ed25519"
file = "SHA256SUMS.sig"
signed_file = "SHA256SUMS"
