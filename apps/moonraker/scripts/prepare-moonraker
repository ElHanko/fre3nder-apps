#!/usr/bin/env python3
"""Stage a pinned offline Moonraker source checkout and SHA256-locked wheels.

No downloads, no system installation, no release signing, no device access.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import zipfile

ROOT = pathlib.Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT / "scripts"))
from stage_fre3app import checked_file, input_digest, package_stage

RECIPE = ROOT / "apps/moonraker"
PACKAGE_FILES = ('upstream.json', 'python-wheels.json', 'licenses/UPSTREAM')


def fail(message):
    raise ValueError(message)


def regular(path):
    return path.is_file() and not path.is_symlink()


def source_pin(source, upstream):
    if (not isinstance(upstream, dict) or upstream.get('schema', 1) != 1
            or not isinstance(upstream.get('commit'), str)
            or not re.fullmatch(r'[0-9a-f]{40}', upstream['commit'])
            or not isinstance(upstream.get('repository'), str) or not upstream['repository']
            or upstream.get('project', 'moonraker') != 'moonraker'):
        fail('invalid Moonraker source definition')
    if not source.is_dir() or source.is_symlink():
        fail("Moonraker source must be a real Git checkout")
    if not (source / '.git').exists():
        fail("Moonraker Git checkout is missing")
    commit = subprocess.check_output(
        ["git", "-C", str(source), "rev-parse", "HEAD"], text=True,
    ).strip()
    if commit != upstream["commit"]:
        fail("Moonraker source HEAD differs from the app recipe pin")
    status = subprocess.check_output(
        ["git", "-C", str(source), "status", "--porcelain=v1"], text=True,
    )
    if status:
        fail("Moonraker source checkout is dirty")
    if not regular(source / "moonraker/moonraker.py"):
        fail("Moonraker entrypoint is missing")


def copy_source(source, destination):
    destination.mkdir(parents=True)
    excluded = {'.git', '__pycache__', '.pytest_cache', '.mypy_cache', '.ruff_cache'}
    names = subprocess.check_output(['git', '-C', str(source), 'ls-files', '-z']).decode().split('\0')
    for name in sorted(filter(None, names)):
        rel = pathlib.Path(name)
        entry = source / rel
        if any(part in excluded for part in rel.parts) or entry.suffix in ('.pyc', '.pyo'):
            continue
        if entry.is_symlink():
            fail(f"Moonraker source symlink is unsupported: {rel}")
        if entry.is_dir():
            (destination / rel).mkdir(parents=True, exist_ok=True)
        elif entry.is_file():
            target = destination / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(entry, target)
            target.chmod(0o644)
        else:
            fail(f"unsupported source entry: {rel}")


def copy_wheels(wheels, lock, destination):
    if not wheels.is_dir() or wheels.is_symlink():
        fail("wheel cache is missing")
    if not isinstance(lock, dict) or lock.get('schema', 1) != 1 or lock.get("target") != {
            "python": "3.12", "platform": "any",
            "implementation": "py", "abi": "none"}:
        fail("unexpected Moonraker pure-Python wheel target")
    if not isinstance(lock.get('wheels'), list) or not lock['wheels']:
        fail('Moonraker wheel lock is empty')
    destination.mkdir(parents=True)
    seen = set()
    for item in lock['wheels']:
        if (not isinstance(item, dict)
                or any(not isinstance(item.get(k), str) or not item[k]
                       for k in ('name', 'version', 'filename', 'sha256'))
                or not re.fullmatch(r'[A-Za-z0-9_.+-]+\.whl', item['filename'])
                or not re.fullmatch(r'[0-9a-f]{64}', item['sha256'])):
            fail('invalid Moonraker wheel lock entry')
        src = wheels / item['filename']
        if not regular(src):
            fail(f"missing regular wheel {src.name}")
        if hashlib.sha256(src.read_bytes()).hexdigest() != item['sha256']:
            fail(f"wheel checksum mismatch: {src.name}")
        if not src.name.endswith('.whl') or '/' in src.name or '\\' in src.name:
            fail('invalid wheel filename')
        with zipfile.ZipFile(src) as archive:
            for member in archive.infolist():
                name = member.filename
                rel = pathlib.PurePosixPath(name)
                if (rel.is_absolute() or not rel.parts or any(
                        x in ('', '.', '..') for x in rel.parts)
                        or '\\' in name):
                    fail(f"unsafe wheel member: {name}")
                if (member.external_attr >> 16) & 0o170000 == stat.S_IFLNK:
                    fail(f"wheel symlink: {name}")
                if '__pycache__' in rel.parts or rel.suffix in ('.pyc', '.pyo'):
                    continue
                if rel.suffix == '.so':
                    fail('universal Moonraker wheel contains a native extension')
                target = destination.joinpath(*rel.parts)
                if member.is_dir():
                    target.mkdir(parents=True, exist_ok=True)
                    continue
                if rel.as_posix() in seen or target.exists():
                    fail(f"duplicate wheel payload member: {name}")
                seen.add(rel.as_posix())
                target.parent.mkdir(parents=True, exist_ok=True)
                with archive.open(member) as src_stream, target.open('xb') as dst:
                    shutil.copyfileobj(src_stream, dst)
                target.chmod(0o644)


def prepare(source, wheels, output, *, upstream=None, lock=None):
    upstream = json.loads(checked_file(RECIPE / 'upstream.json')) if upstream is None else upstream
    lock = json.loads(checked_file(RECIPE / 'python-wheels.json')) if lock is None else lock
    if not isinstance(upstream, dict) or upstream.get('python') != '3.12':
        fail('recipe requires Python 3.12')
    source_pin(source, upstream)
    if output.is_symlink() or (output.exists() and not output.is_dir()):
        fail('payload destination is not a real directory')
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='.moonraker-payload-', dir=output.parent) as tmp:
        stage = pathlib.Path(tmp) / 'payload'
        print('prepare-moonraker: staging pinned source', flush=True)
        copy_source(source, stage / 'source')
        print('prepare-moonraker: verifying pinned wheels', flush=True)
        copy_wheels(wheels, lock, stage / 'python')
        provenance = {
            'schema': 1, 'source': upstream,
            'locked_wheels': [{'name': item['name'],
                               'version': item['version'],
                               'sha256': item['sha256']}
                              for item in lock['wheels']],
        }
        (stage / 'provenance.json').write_text(
            json.dumps(provenance, indent=2, sort_keys=True) + '\n',
            encoding='utf-8',
        )
        # Replace a previous generated payload only after staging succeeds.
        # If staging fails, the existing payload remains untouched.
        previous = pathlib.Path(tmp) / 'previous'
        if output.exists():
            print('prepare-moonraker: replacing existing payload', flush=True)
            output.rename(previous)
        try:
            stage.rename(output)
        except OSError:
            if previous.exists():
                previous.rename(output)
            raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=pathlib.Path, required=True)
    parser.add_argument('--wheels', type=pathlib.Path, required=True)
    parser.add_argument('--upstream', type=pathlib.Path)
    parser.add_argument('--lock', type=pathlib.Path)
    parser.add_argument('--output', type=pathlib.Path,
                        help='prepared package source directory')
    args = parser.parse_args()
    try:
        defaults = {name: checked_file(RECIPE / name) for name in ('upstream.json', 'python-wheels.json')}
        inputs = {
            'upstream.json': checked_file(args.upstream) if args.upstream is not None else defaults['upstream.json'],
            'python-wheels.json': checked_file(args.lock) if args.lock is not None else defaults['python-wheels.json'],
        }
        upstream = json.loads(inputs['upstream.json'])
        lock = json.loads(inputs['python-wheels.json'])
        if not isinstance(upstream, dict) or not isinstance(lock, dict):
            fail('Moonraker upstream and wheel lock must be JSON objects')
        changed = inputs != defaults
        output = args.output or (ROOT / 'local/moonraker/inputs' / input_digest(inputs) / 'package'
                                 if changed else ROOT / 'local/moonraker/package')
        if changed:
            inputs['licenses/UPSTREAM'] = (
                b'Maintained recipe baseline notices; selected build inputs are upstream.json and python-wheels.json.\n\n'
                + checked_file(RECIPE / 'licenses/UPSTREAM'))
        with package_stage(RECIPE, output, files=PACKAGE_FILES, overrides=inputs,
                           protected=(args.upstream, args.lock, args.source, args.wheels)) as stage:
            prepare(args.source.resolve(), args.wheels.resolve(), stage / 'payload',
                    upstream=upstream, lock=lock)
    except (OSError, ValueError, subprocess.CalledProcessError, zipfile.BadZipFile) as exc:
        parser.exit(1, f'prepare-moonraker: {exc}\n')
    print(f'PREPARED={output}')

if __name__ == '__main__':
    main()
