format = 1

[app]
name = "fre3nderscreen"
version = "2026.1.1-fre3nder.1"
release_serial = 1

[publisher]
id = "fre3nder-official"
key_fingerprint = "@PUBLISHER_FINGERPRINT@"

[target]
platform = "fre3nder-x2000"
arch = "mipsel"

[runtime]
service = "service"
autostart = false

[display]
frontend = true
api = 1

[signature]
algorithm = "Ed25519"
file = "SHA256SUMS.sig"
signed_file = "SHA256SUMS"
